# NEO Music —— HW-678 / ESP32-S3 N16R8 默认配置

# 串口：COM11 是 CH343 USB-UART 桥，接的是 UART0(GPIO43/44)。
# 原生 USB 的 D+/D-(GPIO19/20) 已接 U 盘做 Host，不能再当 CDC console，
# 两边抢同一个 USB 外设会造成启动循环，且 COM11 上看不到任何 app 日志。
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# 16MB Flash + 自定义分区表
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 240MHz：MP3 软解 + JPEG 封面解码都要算力
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# N16R8 是 Octal(8线) PSRAM，选 QUAD 会直接起不来
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# 允许大 .bss 数组放 PSRAM：整帧缓冲、封面缓存、唱片位图等占近 200KB，
# 留在内部 RAM 会让 WiFi 与 I2S DMA 分配不到内存（ESP_ERR_NO_MEM -> abort 重启）
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# 在线音乐：HTTP 流与 JSON、封面下载都需要大窗口
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# 主线程栈：UI 绘制 + 歌词解析 + 唱片渲染
# 主任务是唯一不能放 PSRAM 的任务（IDF 在 app_main 之前创建它，那时 PSRAM 未初始化），
# 栈必须从内部 RAM 出。内部 RAM 总共只有 253KB，WiFi/LWIP 与 mbedTLS 也要挤在里面，
# 所以不能无限加大；16KB 是实测安全值。
# ⚠️ 这里曾经设成 12KB，因为当时 UI 线程里同步做 HTTPS 取歌词，TLS 握手把栈撑爆，
#    一点歌就 panic 重启回首页。现已把歌词请求移到独立的后台任务（PSRAM 栈），
#    主任务不再碰网络，12KB 也够用 —— 加到 16KB 只是给绘制与解析留余量。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
